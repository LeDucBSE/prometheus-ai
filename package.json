{
  "name": "prometheus-ai",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @prompt-engine/web",
    "build": "npm run build --workspace @prompt-engine/web",
    "start": "npm run start --workspace @prompt-engine/web",
    "lint": "npm run lint --workspace @prompt-engine/web",
    "typecheck": "npm run typecheck --workspace @prompt-engine/web",
    "test": "npm run test --workspace @prompt-engine/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0"
  }
}
